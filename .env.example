# All VITE_ values are PUBLIC. Never put secret tokens or cookies here.
# GitHub Actions supplies these two automatically from Pages metadata.
VITE_BASE_PATH=/
# Full deployed URL, INCLUDING the repository path, without trailing slash.
VITE_SITE_URL=

# Copy the four public identifiers from https://giscus.app/zh-CN
# Empty identifiers keep comments in a quiet unconfigured state.
VITE_GISCUS_REPO=
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=Announcements
VITE_GISCUS_CATEGORY_ID=
